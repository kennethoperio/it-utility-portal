  "cmd_scripts": [
    {
      "id": 22,
      "title": "Check Domain / Workgroup",
      "type": "PowerShell / CMD",
      "command": "systeminfo | findstr /B /C:\"Domain\"",
      "description": "Displays the domain or workgroup associated with the computer. Useful for diagnosing Active Directory and domain-join issues.",
      "created_at": "2026-08-19 09:19:17"
    },
    {
      "id": 21,
      "title": "Check Windows Edition",
      "type": "PowerShell",
      "command": "Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,BuildNumber",
      "description": "Displays the Windows edition, version, and build number. On newer Windows versions, PowerShell is preferred because WMIC is deprecated.",
      "created_at": "2026-08-19 09:18:52"
    },
    {
      "id": 20,
      "title": "Windows Firewall Status",
      "type": "PowerShell / CMD",
      "command": "netsh advfirewall show allprofiles",
      "description": "Displays Windows Firewall status and configuration for the Domain, Private, and Public network profiles.  Useful when troubleshooting blocked network connections.",
      "created_at": "2026-08-19 09:18:10"
    },
    {
      "id": 19,
      "title": "Temporary File Cleanup",
      "type": "PowerShell / CMD",
      "command": "del /q /f /s \"%TEMP%\\*\" 2>nul",
      "description": "Attempts to remove files from the current user's temporary directory. Useful for freeing some disk space and cleaning temporary files.  Note: Files currently being used by applications may not be deleted.",
      "created_at": "2026-08-19 09:17:52"
    },
    {
      "id": 18,
      "title": "Trace Network Route",
      "type": "PowerShell / CMD",
      "command": "tracert google.com",
      "description": "Displays the network hops between the computer and the destination. Useful for identifying routing problems, high latency, or where connectivity is failing.",
      "created_at": "2026-08-19 09:17:27"
    },
    {
      "id": 17,
      "title": "DNS Troubleshooting",
      "type": "PowerShell / CMD",
      "command": "nslookup google.com",
      "description": "Tests DNS resolution and shows which DNS server is being used to resolve a domain name.",
      "created_at": "2026-08-19 09:17:11"
    },
    {
      "id": 16,
      "title": "Show Listening Ports",
      "type": "PowerShell / CMD",
      "command": "netstat -ano | findstr LISTENING",
      "description": "Shows network ports currently listening for incoming connections.",
      "created_at": "2026-08-19 09:16:54"
    },
    {
      "id": 15,
      "title": "Network Connections",
      "type": "PowerShell / CMD",
      "command": "netstat -ano",
      "description": "Displays active network connections, listening ports, local/remote addresses, and process IDs (PIDs).  Useful for network troubleshooting and identifying which processes are using network connections.",
      "created_at": "2026-08-19 09:16:16"
    },
    {
      "id": 14,
      "title": "Check Disk Space",
      "type": "PowerShell",
      "command": "Get-PSDrive -PSProvider FileSystem",
      "description": "Displays available and used storage on Windows drives. Useful for identifying drives that are almost full.",
      "created_at": "2026-08-19 09:15:51"
    },
    {
      "id": 13,
      "title": "Clear Stuck Print Queue",
      "type": "PowerShell / CMD",
      "command": "net stop spooler\ndel /Q /F \"%systemroot%\\System32\\spool\\PRINTERS\\*\"\nnet start spooler",
      "description": "Stops the Print Spooler, removes pending print jobs, and starts the service again. Useful when documents are permanently stuck in the print queue.",
      "created_at": "2026-08-19 09:15:30"
    },
    {
      "id": 12,
      "title": "Restart Print Spooler",
      "type": "PowerShell / CMD",
      "command": "net stop spooler\nnet start spooler",
      "description": "Restarts the Windows Print Spooler service. Useful when printers are stuck, print jobs aren't processing, or Windows cannot communicate properly with the printer.",
      "created_at": "2026-08-19 09:15:08"
    },
    {
      "id": 11,
      "title": "Check Disk Repair",
      "type": "PowerShell / CMD",
      "command": "chkdsk C: /f",
      "description": "Checks a drive for file-system errors and, when requested, attempts to repair them. Useful for diagnosing disk and file-system problems.",
      "created_at": "2026-08-19 09:14:10"
    },
    {
      "id": 9,
      "title": "Repair Windows Component Store",
      "type": "PowerShell / CMD",
