{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/download",
      "dest": "/api/download.js"
    },
    {
      "src": "/api/upload",
      "dest": "/api/upload.js"
    },
    {
      "src": "/api/manifest",
      "dest": "/api/manifest.js"
    },
    {
      "src": "/admin",
      "dest": "/static/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/static/$1"
    }
  ]
}
